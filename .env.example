# URL pública del backend (repo trinity-nasa-team/MarsWalk-v2), sin "/" final y terminando en /api.
# Vacío → "/api" (en local, el proxy de Vite manda /api a http://localhost:8000).
# En Vercel: Settings → Environment Variables → VITE_API_URL=https://<backend>.vercel.app/api
VITE_API_URL=

# Solo en desarrollo: a dónde manda Vite el proxy de /api (por defecto http://localhost:8000).
# API_PROXY_TARGET=http://localhost:8000

# DONKI (clima espacial) ya no se consulta desde el navegador: lo sirve el backend (/api/mars/space-weather).
